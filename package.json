{
    "name":  "sakurakitchen-worker",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "wrangler dev -c wrangler.sakura-welfare.toml",
                    "check:welfare":  "node --check src/index.js",
                    "test:workspace":  "node --test tests/workspace-dashboard.test.mjs",
                    "test:welfare:smoke":  "node scripts/test-welfare-smoke.mjs",
